# --- Discord ---
DISCORD_TOKEN=
CLIENT_ID=
# Con GUILD_ID los comandos se registran solo en ese servidor (instantáneo). Vacío = global.
GUILD_ID=

# --- MongoDB Atlas ---
MONGODB_URI=mongodb+srv://USUARIO:PASSWORD@cluster0.xxxxx.mongodb.net/coinks-bot?retryWrites=true&w=majority

# --- Administración ---
# IDs de roles (separados por coma) que pueden usar los comandos de admin del bot (los Administradores siempre pueden).
# (ECONOMY_ADMIN_ROLE_IDS sigue funcionando como alias antiguo.)
ADMIN_ROLE_IDS=
# Canal donde el bot avisa de pedidos de tienda y NFTs ganados en cajas (opcional pero recomendado)
ADMIN_LOG_CHANNEL_ID=

# --- Idioma ---
# Idioma de respaldo cuando Discord no indica uno soportado: es | en
DEFAULT_LANG=en

# --- Wallets ---
MAX_WALLETS_PER_USER=5

# --- Blockchain (usa tus propios RPC: Alchemy, Infura, QuickNode...) ---
RPC_EVM_URL=https://eth.llamarpc.com
RPC_RONIN_URL=https://api.roninchain.com/rpc

# --- Tareas programadas ---
NFT_SYNC_CRON=0 3 * * *
CRON_TIMEZONE=UTC

# --- Log de compras / apertura de cajas ---
# Una compra de esta cantidad o más (o NFT, o épico/legendario) sale destacada en el log de compras
PURCHASE_HIGHLIGHT_MIN=5000

# --- Roles por Token ID (1/1) ---
# Opcional. Por defecto se lee data/token-roles.json. En Railway puedes pegar aquí TODO el JSON (en una sola línea)
# y editar el role_id desde la variable, sin tocar el código; esta variable tiene prioridad sobre el archivo.
# TOKEN_ROLES_JSON={"roles":[{"nombre_referencia":"Piggies OG 1/1","coleccion":"Piggies","role_id":"123456789012345678","token_ids":[3,853]}]}
# TOKEN_ROLES_FILE=data/token-roles.json
